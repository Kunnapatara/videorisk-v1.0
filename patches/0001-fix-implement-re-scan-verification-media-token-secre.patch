From 99165f196e75a58e851104515cc185a9046e29c0 Mon Sep 17 00:00:00 2001
From: Kunnapatara <kunnapatara@yahoo.com>
Date: Tue, 20 Oct 2026 07:21:30 +0000
Subject: [PATCH] fix: implement re-scan verification, media token secret, and
 CI workflow

- Re-scan comparison semantics: support notVerifiedIssues and newIssues, evidence-backed domain resolution checks
- Media token secret: enforce pre-shared non-empty secret in production with server startup guard and testability hook
- CI & Dependencies: add GitHub Actions CI workflow and generate package-lock.json with aligned esbuild peer dependency
---
 .github/workflows/ci.yml                      |   38 +
 package-lock.json                             | 2760 +++++++++++++++++
 package.json                                  |    2 +-
 scripts/validate-env.ts                       |   18 +
 server.ts                                     |    5 +-
 src/components/ComparisonView.tsx             |   64 +-
 src/server/intelligence/policyIntelligence.ts |  185 +-
 src/server/routes/api.ts                      |   45 +-
 src/types/index.ts                            |    8 +
 9 files changed, 3085 insertions(+), 40 deletions(-)
 create mode 100644 .github/workflows/ci.yml
 create mode 100644 package-lock.json

diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
new file mode 100644
index 0000000..5f847d8
--- /dev/null
+++ b/.github/workflows/ci.yml
@@ -0,0 +1,38 @@
+name: CI
+
+on:
+  push:
+    branches: [main]
+  pull_request:
+    branches: [main]
+
+concurrency:
+  group: ${{ github.workflow }}-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  verify:
+    name: Lint, Test & Build
+    runs-on: ubuntu-latest
+
+    steps:
+      - name: Checkout repository
+        uses: actions/checkout@v4
+
+      - name: Setup Node.js
+        uses: actions/setup-node@v4
+        with:
+          node-version: 22
+          cache: 'npm'
+
+      - name: Install dependencies
+        run: npm ci
+
+      - name: Run linter and typecheck
+        run: npm run lint
+
+      - name: Run automated verification tests
+        run: npm test
+
+      - name: Run production build
+        run: npm run build

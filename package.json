{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node dist-server/server.mjs",
    "build:client": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist-server/server.mjs",
    "build": "npm run build:client && npm run build:server",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-server server.js",
    "lint": "tsc --noEmit",
    "test": "DATABASE_PATH=data/videorisk_test.db tsx tests/runAllTests.ts",
    "test:phase4-6": "DATABASE_PATH=data/videorisk_test.db tsx tests/phase4_6_gap_closure.test.ts",
    "test:regression": "DATABASE_PATH=data/videorisk_test.db tsx tests/remediation_regression.test.ts",
    "test:billing": "DATABASE_PATH=data/videorisk_test.db tsx tests/stripe_origin_and_refund_lifecycle.test.ts",
    "test:security": "DATABASE_PATH=data/videorisk_test.db tsx tests/server_production_predicate.test.ts && DATABASE_PATH=data/videorisk_test.db tsx tests/security_remediation_group_ab.test.ts && DATABASE_PATH=data/videorisk_test.db tsx tests/launch_blockers_phase1.test.ts",
    "test:whisper:real": "DATABASE_PATH=data/videorisk_test.db tsx tests/whisper_real_verification.test.ts",
    "test:whisper:sha256": "DATABASE_PATH=data/videorisk_test.db tsx tests/whisper_model_sha256.test.ts",
    "test:stripe:harness": "DATABASE_PATH=data/videorisk_test.db tsx tests/stripe_test_mode_e2e_harness.test.ts",
    "verify:whisper:prod": "tsx scripts/verify-whisper-prod.ts",
    "verify:stripe:e2e": "tsx scripts/verify-stripe-test-mode-e2e.ts",
    "test:all": "DATABASE_PATH=data/videorisk_test.db tsx tests/runAllTests.ts && DATABASE_PATH=data/videorisk_test.db tsx tests/phase4_6_gap_closure.test.ts && DATABASE_PATH=data/videorisk_test.db tsx tests/remediation_regression.test.ts && DATABASE_PATH=data/videorisk_test.db tsx tests/stripe_origin_and_refund_lifecycle.test.ts",
    "validate:env": "tsx scripts/validate-env.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/nodemailer": "^8.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.4.0",
    "nodemailer": "^10.6.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "stripe": "^23.0.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
